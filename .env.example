# Copiar este archivo a ".env" y completar con los valores reales.
# ".env" nunca se sube a git (ver .gitignore).

# Mercado Pago (modo sandbox durante todo el desarrollo)
MERCADOPAGO_PUBLIC_KEY_TEST=
MERCADOPAGO_ACCESS_TOKEN_TEST=

# Proveedor de verificación de identidad: Didit — modo sandbox/test
KYC_PROVIDER=didit
KYC_API_KEY_TEST=

# Parámetros de negocio (también existen en Firestore config/parametros,
# pero se usan acá como default local para desarrollo)
MONTO_MINIMO_VERIFICACION=20000
PORCENTAJE_COMISION=5
